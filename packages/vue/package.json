{
  "name": "@viselect/vue",
  "version": "3.10.1",
  "description": "Simple, lightweight and modern library library for making visual DOM Selections.",
  "author": "Simon Reinisch <contact@reinisch.io>",
  "bugs": "https://github.com/simonwep/viselect/issues",
  "homepage": "https://github.com/simonwep/viselect#readme",
  "repository": "git+https://github.com/simonwep/viselect.git",
  "license": "MIT",
  "type": "module",
  "main": "./dist/viselect.umd.cjs",
  "module": "./dist/viselect.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/viselect.js",
      "require": "./dist/viselect.umd.cjs"
    }
  },
  "scripts": {
    "build": "vue-tsc && vite build",
    "dev": "vite"
  },
  "files": [
    "dist/src",
    "dist/*.js",
    "dist/*.cjs",
    "dist/*.map"
  ],
  "keywords": [
    "vue",
    "vuejs",
    "vue3",
    "viselect",
    "typescript",
    "selecting",
    "selection",
    "user-selection",
    "user-interface",
    "ui-library",
    "ui"
  ],
  "peerDependencies": {
    "vue": ">=3.2.0"
  },
  "dependencies": {
    "@viselect/vanilla": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "26.2.0",
    "@vitejs/plugin-vue": "6.0.8",
    "@vue/tsconfig": "0.9.1",
    "typescript": "6.0.3",
    "unplugin-dts": "1.0.3",
    "vite": "8.2.2",
    "vite-plugin-banner": "0.8.1",
    "vue": "3.5.41",
    "vue-tsc": "3.3.11"
  },
  "publishConfig": {
    "access": "public"
  }
}
