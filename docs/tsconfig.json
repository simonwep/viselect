{
    "include": ["demos/*.vue", ".vitepress/config.mts"],
    "compilerOptions": {
        /* Language and environment */
        "lib": ["ESNext", "DOM"],
        "target": "ESNext",
        "module": "ESNext",
        "moduleResolution": "bundler",

        /* Linting and config */
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "erasableSyntaxOnly": true,
        "noFallthroughCasesInSwitch": true,
        "verbatimModuleSyntax": true
    }
}
